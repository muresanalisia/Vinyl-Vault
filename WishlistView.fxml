<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="WishlistViewController">
  <VBox spacing="16">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="10">
      <Button text="Back" onAction="#onBack"/>
      <Label text="My wishlist" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Search bar -->
    <HBox spacing="10">
      <ComboBox fx:id="fieldBox"/>
      <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS" onAction="#onSearch"/>
      <Button text="Search" onAction="#onSearch"/>
    </HBox>
    <Label fx:id="messageLabel"/>

    <TableView fx:id="wishlistTable" prefHeight="300">
      <columns>
        <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
        <TableColumn fx:id="artistColumn" text="Artist(s)" prefWidth="180"/>
        <TableColumn fx:id="yearColumn" text="Year" prefWidth="70"/>
        <TableColumn fx:id="versionColumn" text="Version" prefWidth="120"/>
        <TableColumn fx:id="barcodeColumn" text="Barcode" prefWidth="140"/>
      </columns>
    </TableView>

    <HBox spacing="10">
      <Button text="Move to collection" onAction="#onMoveToCollection"/>
      <Button text="Remove" onAction="#onRemove"/>
    </HBox>
    <HBox spacing="10">
      <Label text="Missing details to move:"/>
      <TextField fx:id="moveBarcodeField" promptText="Barcode" prefWidth="160"/>
      <TextField fx:id="moveYearField" promptText="Year" prefWidth="80"/>
      <TextField fx:id="moveVersionField" promptText="Version" prefWidth="140"/>
    </HBox>

    <!-- Add to wishlist -->
    <Label text="Add to wishlist" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <FlowPane hgap="10" vgap="10">
      <TextField fx:id="titleField" promptText="Title *" prefWidth="200"/>
      <TextField fx:id="artistField" promptText="Artist(s) * (comma separated)" prefWidth="220"/>
      <TextField fx:id="genreField" promptText="Genre(s) (comma separated)" prefWidth="200"/>
      <TextField fx:id="barcodeField" promptText="Barcode" prefWidth="160"/>
      <TextField fx:id="yearField" promptText="Year" prefWidth="80"/>
      <TextField fx:id="versionField" promptText="Version" prefWidth="140"/>
      <Button text="Add to wishlist" onAction="#onAdd"/>
    </FlowPane>
  </VBox>
</ScrollPane>
