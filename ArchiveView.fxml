<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ArchiveViewController">
  <VBox spacing="16">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox spacing="10">
      <Button text="Back" onAction="#onBack"/>
      <Label text="Archive" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>
    <Label fx:id="messageLabel"/>

    <!-- My archive -->
    <Label text="My archive" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
      <ComboBox fx:id="fieldBox"/>
      <TextField fx:id="recordSearchField" promptText="Search..." HBox.hgrow="ALWAYS" onAction="#onSearchRecords"/>
      <Button text="Search" onAction="#onSearchRecords"/>
    </HBox>
    <TableView fx:id="recordTable" prefHeight="250">
      <columns>
        <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
        <TableColumn fx:id="artistColumn" text="Artist(s)" prefWidth="180"/>
        <TableColumn fx:id="yearColumn" text="Year" prefWidth="70"/>
        <TableColumn fx:id="versionColumn" text="Version" prefWidth="120"/>
        <TableColumn fx:id="barcodeColumn" text="Barcode" prefWidth="140"/>
      </columns>
    </TableView>
    <Button text="Unarchive record" onAction="#onUnarchiveRecord"/>

    <!-- My archived groupings -->
    <Label text="My archived groupings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
      <TextField fx:id="groupingSearchField" promptText="Search groupings..." HBox.hgrow="ALWAYS" onAction="#onSearchGroupings"/>
      <Button text="Search" onAction="#onSearchGroupings"/>
    </HBox>
    <TableView fx:id="groupingTable" prefHeight="200">
      <columns>
        <TableColumn fx:id="groupingNameColumn" text="Name" prefWidth="250"/>
      </columns>
    </TableView>
    <Button text="Unarchive grouping" onAction="#onUnarchiveGrouping"/>
  </VBox>
</ScrollPane>
